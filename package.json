{
    "name": "saudicord",
    "version": "0.1.0",
    "private": true,
    "description": "An Arabic-focused desktop client for Discord, based on Vesktop.",
    "keywords": [
        "saudicord",
        "discord",
        "arabic",
        "rtl",
        "electron",
        "desktop-client"
    ],
    "homepage": "https://github.com/xxm-cmyk/SaudiCord-",
    "license": "GPL-3.0-or-later",
    "author": "SaudiCord contributors",
    "main": "dist/js/main.js",
    "scripts": {
        "build": "tsx scripts/build/build.mts",
        "build:dev": "pnpm build --dev",
        "buildLibVesktop": "pnpm -C packages/libvesktop install && pnpm -C packages/libvesktop run build",
        "package": "pnpm build && electron-builder",
        "package:dir": "pnpm build && electron-builder --dir",
        "lint": "oxlint src scripts packages/discord-rpc",
        "lint:fix": "pnpm lint --fix",
        "fmt": "oxfmt",
        "fmt:check": "oxfmt --check",
        "start": "pnpm build && electron --enable-source-maps .",
        "start:dev": "pnpm build:dev && electron --enable-source-maps .",
        "start:watch": "pnpm build:dev && tsx scripts/startWatch.mts",
        "test": "pnpm lint && pnpm fmt:check && pnpm testTypes && pnpm validate:arabic",
        "testTypes": "tsc --noEmit",
        "watch": "pnpm build --watch",
        "generateMeta": "tsx scripts/utils/generateMeta.mts",
        "validate:arabic": "tsx scripts/utils/validateArabicTranslations.mts"
    },
    "dependencies": {
        "electron-updater": "6.6.2"
    },
    "optionalDependencies": {
        "@vencord/venmic": "^7.2.5"
    },
    "devDependencies": {
        "@fal-works/esbuild-plugin-global-externals": "^2.1.2",
        "@types/node": "^26.6.5",
        "@types/react": "19.2.9",
        "@vencord/types": "1.15.14",
        "discord-rpc": "workspace:*",
        "electron": "45.2.3",
        "electron-builder": "^26.18.0",
        "esbuild": "^0.28.2",
        "eslint-plugin-simple-header": "^1.2.2",
        "libvesktop": "link:packages/libvesktop",
        "oxfmt": "^0.76.0",
        "oxlint": "^1.91.0",
        "source-map-support": "^0.5.21",
        "tsx": "^4.23.15",
        "type-fest": "^5.10.0",
        "typescript": "^6.0.3",
        "xml-formatter": "^3.6.7"
    },
    "packageManager": "pnpm@12.16.1",
    "engines": {
        "node": ">=22",
        "pnpm": ">=11"
    },
    "build": {
        "appId": "com.saudicord.desktop",
        "productName": "SaudiCord",
        "executableName": "saudicord",
        "files": [
            "!*",
            "!node_modules",
            "dist/js",
            "static",
            "package.json",
            "CREDITS.md"
        ],
        "protocols": {
            "name": "Discord",
            "schemes": [
                "discord"
            ]
        },
        "beforePack": "scripts/build/beforePack.mjs",
        "afterPack": "scripts/build/afterPack.mjs",
        "toolsets": {
            "appimage": "1.0.3"
        },
        "linux": {
            "icon": "build/icon.svg",
            "category": "Network",
            "target": [
                {
                    "target": "deb",
                    "arch": [
                        "x64",
                        "arm64"
                    ]
                },
                {
                    "target": "tar.gz",
                    "arch": [
                        "x64",
                        "arm64"
                    ]
                },
                {
                    "target": "rpm",
                    "arch": [
                        "x64",
                        "arm64"
                    ]
                },
                {
                    "target": "AppImage",
                    "arch": [
                        "x64",
                        "arm64"
                    ]
                }
            ],
            "desktop": {
                "entry": {
                    "Name": "سعودي كورد",
                    "GenericName": "عميل Discord للمراسلة",
                    "Type": "Application",
                    "Categories": "Network;InstantMessaging;Chat;",
                    "Keywords": "saudicord;discord;electron;chat;",
                    "MimeType": "x-scheme-handler/discord",
                    "StartupWMClass": "saudicord",
                    "Comment": "تطبيق Discord لسطح المكتب بواجهة عربية",
                    "Icon": "saudicord"
                }
            }
        },
        "mac": {
            "target": [
                {
                    "target": "default",
                    "arch": [
                        "universal"
                    ]
                }
            ],
            "category": "public.app-category.social-networking",
            "darkModeSupport": true,
            "extendInfo": {
                "NSMicrophoneUsageDescription": "يحتاج سعودي كورد إلى الوصول إلى الميكروفون للمحادثات الصوتية ومشاركة الشاشة.",
                "NSCameraUsageDescription": "يحتاج سعودي كورد إلى الوصول إلى الكاميرا لمكالمات الفيديو.",
                "com.apple.security.device.audio-input": true,
                "com.apple.security.device.camera": true,
                "CFBundleIconName": "Icon",
                "CFBundleLocalizations": [
                    "ar"
                ]
            },
            "requirements": "build/signing-requirements.txt",
            "notarize": true
        },
        "dmg": {
            "background": "build/background.tiff",
            "icon": "build/icon.icns",
            "iconSize": 105,
            "window": {
                "width": 512,
                "height": 340
            },
            "contents": [
                {
                    "x": 140,
                    "y": 160
                },
                {
                    "x": 372,
                    "y": 160,
                    "type": "link",
                    "path": "/Applications"
                }
            ]
        },
        "nsis": {
            "include": "build/installer.nsh",
            "oneClick": false
        },
        "win": {
            "icon": "build/icon.ico",
            "target": [
                {
                    "target": "nsis",
                    "arch": [
                        "x64",
                        "arm64"
                    ]
                },
                {
                    "target": "zip",
                    "arch": [
                        "x64",
                        "arm64"
                    ]
                }
            ]
        },
        "publish": {
            "provider": "github",
            "owner": "xxm-cmyk",
            "repo": "SaudiCord-"
        },
        "rpm": {
            "fpm": [
                "--rpm-rpmbuild-define=_build_id_links none"
            ]
        },
        "electronFuses": {
            "runAsNode": false,
            "enableCookieEncryption": false,
            "enableNodeOptionsEnvironmentVariable": false,
            "enableNodeCliInspectArguments": false,
            "enableEmbeddedAsarIntegrityValidation": true,
            "onlyLoadAppFromAsar": true,
            "loadBrowserProcessSpecificV8Snapshot": false,
            "grantFileProtocolExtraPrivileges": false
        }
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/xxm-cmyk/SaudiCord-.git"
    }
}
